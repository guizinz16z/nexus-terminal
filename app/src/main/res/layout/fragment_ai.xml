<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- AI Header & Key Config -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ai"
            app:tint="@color/accent_violet" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Nexus AI Code Copilot"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_config_ai_key"
            style="@style/Widget.Nexus.TerminalKey"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Chave API"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Prompts Horizontal Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@color/bg_card_secondary"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <Button
                android:id="@+id/chip_explain_code"
                style="@style/Widget.Nexus.TerminalKey"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:text="💡 Explicar Código"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_debug_error"
                style="@style/Widget.Nexus.TerminalKey"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:text="🐛 Corrigir Erro"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_optimize_code"
                style="@style/Widget.Nexus.TerminalKey"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="⚡ Otimizar Script"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ai_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp" />

    <!-- Prompt Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <EditText
            android:id="@+id/et_ai_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Pergunte ao Nexus AI ou cole um erro..."
            android:inputType="textCapSentences"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btn_send_ai_prompt"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="Enviar"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            app:tint="@color/accent_violet" />
    </LinearLayout>
</LinearLayout>
