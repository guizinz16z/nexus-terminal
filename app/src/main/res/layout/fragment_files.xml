<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Files Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tv_current_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="/workspace"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btn_new_file"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="Novo Arquivo"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/btn_refresh_files"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="Atualizar"
            android:padding="6dp"
            android:src="@drawable/ic_nav_tools"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Files List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp" />
</LinearLayout>
