<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Tabs & Editor Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Tabs Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_editor_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_active_file_tab"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="main.py"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Save Button -->
        <ImageView
            android:id="@+id/btn_editor_save"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="Salvar"
            android:padding="6dp"
            android:src="@drawable/ic_save"
            app:tint="@color/text_primary" />

        <!-- AI Assistant Helper -->
        <ImageView
            android:id="@+id/btn_editor_ai"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="AI Code"
            android:padding="6dp"
            android:src="@drawable/ic_ai"
            app:tint="@color/accent_violet" />

        <!-- Run Python Script Button -->
        <ImageView
            android:id="@+id/btn_editor_run"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="Executar Script"
            android:padding="6dp"
            android:src="@drawable/ic_play"
            app:tint="@color/accent_emerald" />
    </LinearLayout>

    <!-- Editor Main Workspace (Line Numbers + Code Area) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#070A11"
        android:orientation="horizontal">

        <!-- Line Numbers Column -->
        <TextView
            android:id="@+id/tv_line_numbers"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:background="#0B0F1A"
            android:fontFamily="monospace"
            android:gravity="top|end"
            android:lineSpacingExtra="2dp"
            android:paddingEnd="6dp"
            android:paddingTop="12dp"
            android:text="1\n2\n3\n4\n5"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/stroke_glass" />

        <!-- Code Input Area -->
        <EditText
            android:id="@+id/et_code_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="# Escreva seu script Python aqui...\nprint('Olá do Nexus Terminal!')"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="@color/text_code"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Coding Symbols Bar for Mobile Typing -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@color/bg_card_secondary"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_symbols_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/sym_tab"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="48dp"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="TAB" />

            <Button
                android:id="@+id/sym_colon"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text=":" />

            <Button
                android:id="@+id/sym_paren_open"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="(" />

            <Button
                android:id="@+id/sym_paren_close"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text=")" />

            <Button
                android:id="@+id/sym_bracket_open"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="[" />

            <Button
                android:id="@+id/sym_bracket_close"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="]" />

            <Button
                android:id="@+id/sym_brace_open"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="{" />

            <Button
                android:id="@+id/sym_brace_close"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="}" />

            <Button
                android:id="@+id/sym_equals"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="=" />

            <Button
                android:id="@+id/sym_quote"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="\&quot;" />

            <Button
                android:id="@+id/sym_hash"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="#" />

            <Button
                android:id="@+id/sym_dot"
                style="@style/Widget.Nexus.EditorSymbolKey"
                android:layout_width="@dimen/editor_symbol_width"
                android:layout_height="@dimen/editor_symbol_height"
                android:layout_marginEnd="4dp"
                android:text="." />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Execution Drawer (Stdout / Stderr console preview) -->
    <LinearLayout
        android:id="@+id/layout_output_drawer"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#050810"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@color/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Saída do Script Python"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_output"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Fechar"
                android:src="@drawable/ic_stop"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_script_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_code"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
