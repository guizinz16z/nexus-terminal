<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Nexus.GlassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_file_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_nav_files"
            app:tint="@color/accent_violet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_file_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="script.py"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_file_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2.4 KB • 23/11/2026"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_file_options"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Opções"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
