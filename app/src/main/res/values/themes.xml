<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.NexusTerminal" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorPrimaryVariant">@color/accent_violet_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <item name="colorTertiary">@color/accent_indigo</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card_secondary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Glassmorphic Card Style -->
    <style name="Widget.Nexus.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card_glass</item>
        <item name="cardCornerRadius">@dimen/corner_radius_normal</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_glass</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Terminal Special Key Button Style -->
    <style name="Widget.Nexus.TerminalKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/bg_surface_overlay</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">@color/stroke_glass</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Code Editor Symbol Key Style -->
    <style name="Widget.Nexus.EditorSymbolKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/bg_card_secondary</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
    </style>
</resources>
